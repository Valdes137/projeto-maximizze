# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Configurações do Banco de Dados
# Se estiver usando XAMPP, a senha geralmente é vazia ou 'root'
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=maya
DB_NAME=maximizee_db

# Segredos de Segurança (JWT)
JWT_SECRET=maximizee-secret-key-2025
JWT_EXPIRATION=7d
REFRESH_TOKEN_EXPIRATION=30d